{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "a8csp/wc-product-addons-mini-cart",
	"version": "0.2.0",
	"title": "Mini-Cart Products with Add-ons",
	"category": "woocommerce",
	"icon": "cart",
	"description": "The Mini-Cart products table, with each line's add-ons under it. Use it in place of the Mini-Cart Products Table block.",

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "a8csp/kb-docs-content",
	"version": "0.9.0",
	"title": "KB Docs Content",
	"category": "widgets",
	"icon": "book-alt",
	"description": "Container for docs page content. Add blocks for the docs home, category archives, or articles.",
	"supports": {
		"html": false,
		"multiple": false,
		"interactivity": {
			"interactive": true,
			"clientNavigation": true
		},
		"color": {
			"background": true,
			"text": true,
			"link": true
		}
	},
	"textdomain": "kb-docs",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}

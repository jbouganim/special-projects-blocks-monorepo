{
	"name": "copy-to-markdown",
	"version": "0.3.0",
	"description": "A button that copies page content to the clipboard as Markdown.",
	"author": "WordPress Special Projects Team",
	"license": "GPL-2.0-or-later",
	"homepage": "https://wpspecialprojects.wordpress.com/",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build --experimental-modules --webpack-copy-php",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start --experimental-modules --webpack-copy-php"
	},
	"files": [
		"[^.]*"
	],
	"dependencies": {
		"@wordpress/interactivity": "^6.9.0",
		"turndown": "^7.2.0",
		"turndown-plugin-gfm": "^1.0.2"
	},
	"devDependencies": {
		"@wordpress/scripts": "^30.27.0"
	}
}

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "a8csp/kb-docs-sidebar",
	"version": "0.9.0",
	"title": "KB Docs Sidebar",
	"category": "widgets",
	"icon": "list-view",
	"description": "Docs navigation sidebar with configurable sections and article links.",
	"attributes": {
		"taxonomy": {
			"type": "string",
			"default": "kb_cat"
		},
		"postType": {
			"type": "string",
			"default": "kb_article"
		},
		"sectionOrderBy": {
			"type": "string",
			"default": "name"
		},
		"sectionOrder": {
			"type": "string",
			"default": "asc"
		},
		"articleOrderBy": {
			"type": "string",
			"default": "menu_order"
		},
		"articleOrder": {
			"type": "string",
			"default": "asc"
		},
		"includeChildren": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"multiple": false,
		"anchor": true,
		"align": ["wide", "full"],
		"interactivity": {
			"interactive": true,
			"clientNavigation": true
		},
		"color": {
			"background": true,
			"text": true,
			"link": true,
			"gradients": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true,
				"link": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true,
			"__experimentalSkipSerialization": ["blockGap"],
			"__experimentalDefaultControls": {
				"padding": true,
				"margin": false,
				"blockGap": true
			}
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true,
				"lineHeight": false
			}
		},
		"dimensions": {
			"minHeight": true
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true,
			"__experimentalDefaultControls": {
				"radius": false,
				"color": true,
				"width": true,
				"style": true
			}
		}
	},
	"textdomain": "kb-docs",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
